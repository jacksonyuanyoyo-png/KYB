{
  "name": "complex-account-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "npm --workspace @fcc/api run db:generate",
    "db:migrate": "npm --workspace @fcc/api run db:migrate",
    "up": "bash scripts/up.sh",
    "down": "bash scripts/down.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
